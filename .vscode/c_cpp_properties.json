{
  "configurations": [
    {
      "name": "Mac",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/backend",
        "${workspaceFolder}/backend/api",
        "/opt/homebrew/opt/openssl/include",
        "/opt/homebrew/opt/ffmpeg/include",
        "/opt/homebrew/opt/opencv/include/opencv4",
        "/opt/homebrew/include"
      ],
      "defines": [],
