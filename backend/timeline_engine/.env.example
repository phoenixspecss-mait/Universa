# Application Settings
APP_NAME="Forensic Timeline & Integration Engine"
ENVIRONMENT="local"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration
DATABASE_URL="sqlite+aiosqlite:///./forensic_timeline.db"

# Pipeline & Ingestion Settings (Configurable Buffers & Thresholds)
PIPELINE_QUEUE_MAX_SIZE=2000
PIPELINE_WORKER_BATCH_SIZE=50
PIPELINE_DRAIN_TIMEOUT_SECONDS=5.0
DEDUPLICATION_CACHE_SIZE=10000

# Correlation Engine Settings
CORRELATION_WINDOW_SECONDS=5.0
CORRELATION_BUFFER_MAX_SIZE=5000
ALLOWED_LATENESS_SECONDS=10.0
COSINE_SIMILARITY_THRESHOLD=0.82

# Normalization & Anomaly Detection Settings
TIMELINE_GAP_THRESHOLD_SECONDS=30.0
TIME_REGRESSION_THRESHOLD_SECONDS=1.0
DEFAULT_FALLBACK_TIMEZONE="UTC"
